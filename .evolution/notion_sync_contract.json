  "github_to_notion": {
    "allowed_after_evidence": [
      "merged pull request summary",
      "commit and branch anchors",
      "changed-file list",
      "CI and verifier outcomes",
      "claim ceiling changes",
      "known unknowns",
      "retain, rollback, revise or retire decisions"
